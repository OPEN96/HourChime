<Window x:Class="HourChime.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Width="396" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        FontFamily="Microsoft YaHei UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="22,20">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="确认" FontSize="13.5" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" Foreground="{StaticResource SubFg}" TextWrapping="Wrap"
                       Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="86"
                        Click="Cancel_Click" />
                <Button Content="删除" Style="{StaticResource PrimaryButton}" Width="86" Margin="10,0,0,0"
                        Background="{StaticResource Danger}" Foreground="#2A0E14"
                        Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
