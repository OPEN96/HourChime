<Window x:Class="HourChime.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="整点报时 · 提醒闹钟"
        Icon="pack://application:,,,/app.ico"
        Width="1020" Height="828" MinWidth="940" MinHeight="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        FontFamily="Microsoft YaHei UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource SubFg}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262D3A" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3746" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlarmRow" TargetType="Border">
            <Setter Property="Background" Value="#181D26" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C222C" />
                    <Setter Property="BorderBrush" Value="#2E3644" />
                </Trigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowTextButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource SubFg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#262D3A" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3746" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlarmItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Accent}">
                        <Ellipse Width="6" Height="6" Fill="#1A1408" />
                    </Border>
                    <TextBlock Text="整点报时" Margin="9,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border x:Name="StatusPill" Background="#16241D" CornerRadius="6" Padding="7,2"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{StaticResource Ok}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="运行中" FontSize="10.5" Margin="5,0,0,0"
                                       Foreground="{StaticResource Ok}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click"
                            ToolTip="最小化到托盘" FontSize="12" />
                    <Button Style="{StaticResource TitleBarButton}" Content="✕" Click="Close_Click"
                            ToolTip="关闭" FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- ===== 内容 ===== -->
            <Grid Grid.Row="1" Margin="22,2,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="404" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 左列 -->
                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 时钟 -->
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="现在时间" Style="{StaticResource HintText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <TextBlock x:Name="ClockText" Text="--:--" FontSize="42" FontWeight="Light"
                                               FontFamily="Segoe UI, Microsoft YaHei UI" />
                                    <TextBlock x:Name="SecondsText" Text=":--" FontSize="17"
                                               Foreground="{StaticResource SubFg}" VerticalAlignment="Bottom"
                                               Margin="3,0,0,7" />
                                </StackPanel>
                                <TextBlock x:Name="DateText" Style="{StaticResource HintText}" Margin="3,0,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderSoft}"
                                    Margin="0,4,18,4" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        MinWidth="150">
                                <TextBlock Text="下一个闹钟" Style="{StaticResource HintText}"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="NextTimeText" Text="--:--" FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" Margin="0,2,0,0" />
                                <TextBlock x:Name="NextLabelText" Text="还没有闹钟" Style="{StaticResource HintText}"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 整点报时 -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="整点报时" Style="{StaticResource TitleText}" />
                                    <TextBlock Text="整点/半点语音播报" Style="{StaticResource HintText}"
                                               Margin="8,2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleButton x:Name="HourlyToggle" Style="{StaticResource ToggleSwitch}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Click="HourlyToggle_Click" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,12,0,12" />

                            <StackPanel x:Name="HourlyPanel">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="播报方式" Style="{StaticResource SectionText}" />
                                    <Border Grid.Column="1" Style="{StaticResource Inset}" Padding="2">
                                        <UniformGrid Columns="3">
                                            <RadioButton x:Name="ModeVoice" GroupName="Mode" Content="语音"
                                                         Style="{StaticResource Segment}" Checked="Mode_Checked" />
                                            <RadioButton x:Name="ModeChime" GroupName="Mode" Content="提示音"
                                                         Style="{StaticResource Segment}" Checked="Mode_Checked" />
                                            <RadioButton x:Name="ModeBoth" GroupName="Mode" Content="语音+提示音"
                                                         Style="{StaticResource Segment}" Checked="Mode_Checked" />
                                        </UniformGrid>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="报时时刻" Style="{StaticResource SectionText}" />
                                    <Border Grid.Column="1" Style="{StaticResource Inset}" Padding="2">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="FreqHour" GroupName="Freq" Content="仅整点"
                                                         Style="{StaticResource Segment}" Checked="Freq_Checked" />
                                            <RadioButton x:Name="FreqHourHalf" GroupName="Freq" Content="整点 + 半点"
                                                         Style="{StaticResource Segment}" Checked="Freq_Checked" />
                                        </UniformGrid>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="语音" Style="{StaticResource SectionText}" />
                                    <ComboBox x:Name="VoiceBox" Grid.Column="1" Style="{StaticResource Combo}"
                                              SelectionChanged="VoiceBox_SelectionChanged" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="语速" Style="{StaticResource SectionText}" />
                                    <Slider x:Name="RateSlider" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                            Minimum="-10" Maximum="10" SmallChange="1" IsSnapToTickEnabled="True"
                                            TickFrequency="1" ValueChanged="RateSlider_ValueChanged"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="RateValue" Grid.Column="2" Text="0" Style="{StaticResource HintText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音量" Style="{StaticResource SectionText}" />
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                            Minimum="0" Maximum="100" SmallChange="1" IsSnapToTickEnabled="True"
                                            TickFrequency="1" ValueChanged="VolumeSlider_ValueChanged"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="VolumeValue" Grid.Column="2" Text="90%" Style="{StaticResource HintText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="提示音" Style="{StaticResource SectionText}" />
                                    <Border Grid.Column="1" Style="{StaticResource Inset}" Height="34" Padding="10,0">
                                        <TextBlock x:Name="ChimeText" Text="内置三音阶" VerticalAlignment="Center"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButton}"
                                            Height="34" Width="62" Margin="8,0,0,0" FontSize="12"
                                            Click="BrowseChime_Click" />
                                    <Button x:Name="ResetChimeButton" Grid.Column="3" Content="重置"
                                            Style="{StaticResource GhostButton}" Height="34" Width="44"
                                            Margin="2,0,0,0" FontSize="12" Click="ResetChime_Click"
                                            ToolTip="恢复内置三音阶" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="免打扰" Style="{StaticResource SectionText}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton x:Name="QuietToggle" Style="{StaticResource ToggleSwitch}"
                                                      Click="QuietToggle_Click" />
                                        <TextBox x:Name="QuietFromBox" Width="66" Margin="12,0,0,0" Height="30"
                                                 Style="{StaticResource Input}" TextAlignment="Center" Padding="4,0"
                                                 LostFocus="QuietTime_LostFocus" />
                                        <TextBlock Text="至" Style="{StaticResource SectionText}" Margin="6,0" />
                                        <TextBox x:Name="QuietToBox" Width="66" Height="30"
                                                 Style="{StaticResource Input}" TextAlignment="Center" Padding="4,0"
                                                 LostFocus="QuietTime_LostFocus" />
                                        <TextBlock Text="静音" Style="{StaticResource HintText}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Grid Margin="0,2,0,0">
                                <Button Content="试听效果" Style="{StaticResource SecondaryButton}" Height="32"
                                        Width="92" HorizontalAlignment="Left" FontSize="12"
                                        Click="Preview_Click" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="整点同时弹窗" Style="{StaticResource SectionText}"
                                               Margin="0,0,8,0" />
                                    <ToggleButton x:Name="HourlyToastToggle" Style="{StaticResource ToggleSwitch}"
                                                  Click="HourlyToast_Click" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="VoiceHint" Style="{StaticResource HintText}" Margin="0,10,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 右列：闹钟 -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="闹钟" Style="{StaticResource TitleText}" />
                                <Border Background="#232936" CornerRadius="6" Padding="7,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CountText" Text="0" FontSize="10.5"
                                               Foreground="{StaticResource SubFg}" />
                                </Border>
                            </StackPanel>
                            <Button Content="＋ 新建闹钟" Style="{StaticResource PrimaryButton}" Height="32"
                                    HorizontalAlignment="Right" FontSize="12" Click="AddAlarm_Click" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <ListBox x:Name="AlarmList" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource AlarmItemContainer}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AlarmRow}" MouseLeftButtonDown="AlarmRow_MouseDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding TimeText}" FontSize="22" FontWeight="Light"
                                                           FontFamily="Segoe UI, Microsoft YaHei UI"
                                                           VerticalAlignment="Center" MinWidth="72" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                            Margin="12,0,10,0">
                                                    <TextBlock Text="{Binding LabelText}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource HintText}"
                                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="编辑" Style="{StaticResource RowTextButton}"
                                                            Margin="0,0,2,0" ToolTip="编辑" Click="EditAlarm_Click" />
                                                    <Button Content="删除" Style="{StaticResource RowTextButton}"
                                                            Margin="0,0,8,0" ToolTip="删除" Click="DeleteAlarm_Click" />
                                                    <ToggleButton IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                  Style="{StaticResource ToggleSwitch}"
                                                                  Margin="6,0,0,0" Click="AlarmEnable_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           Foreground="{StaticResource MutedFg}" HorizontalAlignment="Center" />
                                <TextBlock Text="还没有闹钟" Margin="0,12,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource SubFg}" />
                                <TextBlock Text="点击右上角「新建闹钟」开始" Style="{StaticResource HintText}"
                                           Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource Inset}" Padding="14,10" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="未确认时" Style="{StaticResource SectionText}" />
                                    <ComboBox x:Name="RepeatMinutesBox" Style="{StaticResource Combo}" Width="62"
                                              Height="30" Padding="10,0,26,0" Margin="8,0,0,0"
                                              SelectionChanged="RepeatSetting_Changed" />
                                    <TextBlock Text="分钟再提醒，最多" Style="{StaticResource SectionText}"
                                               Margin="8,0,0,0" />
                                    <ComboBox x:Name="RepeatTimesBox" Style="{StaticResource Combo}" Width="62"
                                              Height="30" Padding="10,0,26,0" Margin="8,0,0,0"
                                              SelectionChanged="RepeatSetting_Changed" />
                                    <TextBlock Text="次" Style="{StaticResource SectionText}" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="填 0 分钟表示只提醒一次；弹窗自动消失且未点击按钮时才会重复。"
                                           Style="{StaticResource HintText}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 底部：偏好 -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="18,12"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="偏好设置" Style="{StaticResource TitleText}" VerticalAlignment="Center"
                                   Margin="0,0,20,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="AutoStartToggle" Style="{StaticResource ToggleSwitch}"
                                          Click="AutoStart_Click" />
                            <TextBlock Text="开机自启" Style="{StaticResource SectionText}" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="StartMinToggle" Style="{StaticResource ToggleSwitch}"
                                          Click="StartMin_Click" />
                            <TextBlock Text="启动时最小化" Style="{StaticResource SectionText}" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="CloseTrayToggle" Style="{StaticResource ToggleSwitch}"
                                          Click="CloseTray_Click" />
                            <TextBlock Text="关闭到托盘" Style="{StaticResource SectionText}" Margin="8,0,0,0" />
                        </StackPanel>

                        <Button x:Name="PauseButton" Grid.Column="4" Content="暂停提醒 30 分钟"
                                Style="{StaticResource SecondaryButton}" Height="32" FontSize="12"
                                Click="Pause_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
