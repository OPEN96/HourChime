<Window x:Class="HourChime.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提醒" Width="416" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Grid Margin="16">
        <Border x:Name="Card" Background="#1B202A" CornerRadius="14"
                BorderBrush="#2C3340" BorderThickness="1" Padding="18,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270"
                                  Color="#000000" Opacity="0.65" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30" CornerRadius="10" Background="{StaticResource AccentSoft}">
                        <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,8,0"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock x:Name="TimeText" Grid.Column="2" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                </Grid>

                <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,0"
                           Foreground="#A9B1C2" TextWrapping="Wrap" MaxWidth="330"
                           HorizontalAlignment="Left" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button x:Name="SnoozeButton" Style="{StaticResource SecondaryButton}" Height="30"
                            FontSize="12" Margin="0,0,8,0" Click="Snooze_Click" />
                    <Button Content="知道了" Style="{StaticResource PrimaryButton}" Height="30"
                            FontSize="12" Width="82" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
